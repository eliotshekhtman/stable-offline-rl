{
  "version": 2,
  "setting": "clean-medium-v2",
  "seeds": [10000, 10100, 10200, 10300],
  "ablation": {"name": "other_fraction", "values": [0, 0.25, 0.5, 0.75, 1]},
  "match": {
    "dataset_spec.num_samples": 999995,
    "dataset_spec.test_fraction": 0.2,
    "training_config.epoch": 3000,
    "training_config.step_per_epoch": 1000,
    "training_config.batch_size": 256
  },
  "series": [{
    "algo": "mobile",
    "match": {
      "training_config.real_ratio": 0.05,
      "training_config.rollout_length": 5,
      "training_config.rollout_batch_size": 50000,
      "training_config.penalty_coef": 0.5,
      "training_config.actor_lr": 0.0001,
      "training_config.critic_lr": 0.0003,
      "training_config.dynamics_max_epochs": 30
    }
  }]
}
